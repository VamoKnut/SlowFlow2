root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,razor}]
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,props,targets,csproj,sln,ini,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cpp,h,hpp}]
indent_style = space
indent_size = 2
